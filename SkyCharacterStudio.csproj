<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SkyCharacterStudio.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SkyCharacterStudio.ico" />
    <Resource Include="Assets\SkyCharacterStudio.png" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="SPIRV-Cross.NET" Version="1.0.2" GeneratePathProperty="true" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <Content Include="$(NuGetPackageRoot)spirv-cross.net/1.0.2/content/spirv-cross.dll" Link="spirv-cross.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
